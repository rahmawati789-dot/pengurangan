        function renderMatchingBoard() {
            const leftCol = document.getElementById('match-col-left');
            const rightCol = document.getElementById('match-col-right');

            leftCol.innerHTML = '<h3 class="text-xs font-bold uppercase text-slate-400 tracking-wider text-center">Soal Pengurangan/Penjumlahan</h3>';
            rightCol.innerHTML = '<h3 class="text-xs font-bold uppercase text-slate-400 tracking-wider text-center">Hasil Jawaban</h3>';

            // Shuffle right column options for variety
            let shuffledRight = [...matchPairs].sort(() => 0.5 - Math.random());

            matchPairs.forEach(item => {
                const isMatched = matchedIds.includes(item.id);
                const isSelected = state.selectedMatchLeft === item.id;

                const btn = document.createElement('button');
                btn.className = `w-full p-4 rounded-2xl font-heading font-extrabold text-lg border-2 text-center transition-all ${
                    isMatched 
                        ? 'bg-emerald-100 border-emerald-400 text-emerald-800 opacity-60 cursor-default' 
                        : isSelected 
                            ? 'bg-indigo-600 text-white border-indigo-800 ring-4 ring-indigo-200' 
                            : 'bg-white border-slate-200 text-slate-800 hover:border-indigo-400 shadow-sm'
                }`;
                btn.innerText = item.left;
                if (!isMatched) {
                    btn.onclick = () => selectMatchLeft(item.id);
                }
                leftCol.appendChild(btn);
            });

            shuffledRight.forEach(item => {
                const isMatched = matchedIds.includes(item.id);
                const isSelected = state.selectedMatchRight === item.id;

                const btn = document.createElement('button');
                btn.className = `w-full p-4 rounded-2xl font-heading font-extrabold text-lg border-2 text-center transition-all ${
