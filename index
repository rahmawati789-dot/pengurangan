                <div class="flex items-center space-x-3 mb-6">
                    <span class="text-3xl">📚</span>
                    <div>
                        <h2 class="text-2xl font-bold text-indigo-900">Materi: Penjumlahan & Pengurangan Sampai 1000</h2>
                        <p class="text-sm text-slate-500">Pelajari konsep dasar dengan visual yang mudah dipahami.</p>
                    </div>
                </div>

                <!-- Sub-tab Navigation for Materials -->
                <div class="flex flex-wrap gap-2 border-b border-slate-200 pb-4 mb-6">
