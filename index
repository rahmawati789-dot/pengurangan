        function updateResultsUI() {
            document.getElementById('res-total-score').innerText = state.score;
            document.getElementById('res-boxes-opened').innerText = `${state.boxesOpenedCount} / 6`;
            document.getElementById('res-matches-done').innerText = `${state.matchesDoneCount} / 5`;
            checkBadges();

            const msgEl = document.getElementById('motivational-msg');
            if (state.score > 300) {
                msgEl.innerText = '"Luar biasa! Kamu adalah Master Matematika sejati! Teruskan semangat belajarmu!" 🌟';
            } else if (state.score > 100) {
                msgEl.innerText = '"Kerja bagus! Kemampuan berhitungmu semakin hebat setiap hari!" 🚀';
            } else {
                msgEl.innerText = '"Belajar matematika itu seperti bermain teka-teki! Semakin sering berlatih, semakin mudah!" 🐰';
            }
        }

        function resetAllProgress() {
            if (confirm("Apakah kamu yakin ingin mengulang dari awal?")) {
                state.score = 0;
                state.boxesOpenedCount = 0;
                state.matchesDoneCount = 0;
                state.boxesOpenedState = [false, false, false, false, false, false];
                state.badgesEarned = { easyQuiz: false, boxesAll: false, matchingAll: false, hardQuiz: false };
                document.getElementById('global-score').innerText = '0';
                renderBoxes();
                initMatchingGame();
                updateResultsUI();
                switchTab('beranda');
            }
        }

        window.onload = function() {
            renderBoxes();
            initMatchingGame();
            updateSimulation();
            checkBadges();
        };
    </script>
</body>
</html>