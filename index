        function updateSimulation() {
            let num1 = parseInt(document.getElementById('sim-num1').value) || 0;
            let op = document.getElementById('sim-op').value;
            let num2 = parseInt(document.getElementById('sim-num2').value) || 0;

            // Clamp inputs up to 1000
            num1 = Math.min(Math.max(num1, 0), 1000);
            num2 = Math.min(Math.max(num2, 0), 1000);

            let result = op === '-' ? num1 - num2 : num1 + num2;
            let displayResult = result;

            document.getElementById('sim-equation-text').innerText = `${num1} ${op} ${num2} = ${displayResult}`;

            // Calculate hundreds, tens, ones for visual display of the RESULT
            let visualNum = Math.abs(result);
            let hundreds = Math.floor(visualNum / 100);
            let tens = Math.floor((visualNum % 100) / 10);
            let ones = visualNum % 10;

            document.getElementById('sim-hundreds-count').innerText = hundreds;
            document.getElementById('sim-tens-count').innerText = tens;
            document.getElementById('sim-ones-count').innerText = ones;

            // Render Hundreds Blocks
            const hContainer = document.getElementById('sim-hundreds-container');
            hContainer.innerHTML = '';
            for (let i = 0; i < Math.min(hundreds, 10); i++) {
                const block = document.createElement('div');
                block.className = 'w-10 h-10 bg-blue-500 border-2 border-blue-700 rounded-lg flex items-center justify-center text-white text-[10px] font-bold shadow-sm hover:scale-110 transition-transform';
                block.innerText = '100';
                hContainer.appendChild(block);
            }

            // Render Tens Blocks
            const tContainer = document.getElementById('sim-tens-container');
            tContainer.innerHTML = '';
            for (let i = 0; i < Math.min(tens, 20); i++) {
                const block = document.createElement('div');
                block.className = 'w-4 h-10 bg-emerald-500 border border-emerald-700 rounded flex flex-col justify-between p-0.5 shadow-sm hover:scale-110 transition-transform';
                block.title = '10';
                tContainer.appendChild(block);
            }

            // Render Ones Blocks
            const oContainer = document.getElementById('sim-ones-container');
            oContainer.innerHTML = '';
            for (let i = 0; i < Math.min(ones, 20); i++) {
                const block = document.createElement('div');
                block.className = 'w-4 h-4 bg-pink-500 border border-pink-700 rounded-sm shadow-sm hover:scale-110 transition-transform';
                block.title = '1';
                oContainer.appendChild(block);
            }

            // Generate Cause and Effect Explanation Text
            const expText = document.getElementById('sim-explanation-text');
            if (op === '-') {
                if (result < 0) {
                    expText.innerText = `⚠️ Perhatian: Bilangan pertama (${num1}) lebih kecil dari pengurangan (${num2}), sehingga hasilnya negatif (${result}). Dalam pembelajaran kelas 3, pastikan bilangan awal lebih besar!`;
                } else {
                    let n1Ones = num1 % 10;
                    let n2Ones = num2 % 10;
                    if (n1Ones < n2Ones) {
                        expText.innerHTML = `💡 <b>Ada proses meminjam!</b> Karena satuan ${n1Ones} lebih kecil dari ${n2Ones}, kita meminjam 1 puluhan dari sebelahnya. Sehingga tersisa <b>${hundreds} ratusan, ${tens} puluhan, dan ${ones} satuan</b> (Total = ${result}).`;
                    } else {
                        expText.innerHTML = `✅ <b>Pengurangan Langsung:</b> Setiap angka awal lebih besar dari angka pengurang. Tinggal dikurangi sesuai nilai tempatnya!`;
                    }
                }
            } else {
                expText.innerHTML = `➕ <b>Penggabungan Blok:</b> Menambahkan ${num1} dan ${num2} menggabungkan semua ratusan, puluhan, dan satuan sehingga membentuk total <b>${result}</b>.`;
            }
        }

