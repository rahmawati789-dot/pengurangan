                    <button onclick="showSubMateri(2)" id="submateri-btn-2" class="submateri-btn px-4 py-2 rounded-xl font-bold text-sm bg-slate-100 text-slate-600 hover:bg-slate-200">2. Pengurangan Tanpa Meminjam</button>
